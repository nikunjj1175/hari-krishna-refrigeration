# ==========================================
# HARI KRISHNA REFRIGERATION - ENV VARIABLES
# ==========================================

# Database
MONGODB_URI=mongodb://localhost:27017/hari-krishna-refrigeration
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/hari-krishna-refrigeration

# JWT Auth (365-day token, no auto logout)
JWT_SECRET=your-super-secret-jwt-secret-min-32-chars
# Optional fallback if JWT_SECRET is not set
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-min-32-chars

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v20.0

# File Storage (local or cloud)
# STORAGE_PROVIDER=local | cloudinary | s3
STORAGE_PROVIDER=cloudinary
UPLOAD_DIR=./public/uploads

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# App
NEXT_PUBLIC_APP_NAME=Hari Krishna Refrigeration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Seed (used for initial seed script)
SEED_ADMIN_EMAIL=admin@harikrishnarefrigeration.com
SEED_ADMIN_PASSWORD=Admin@123456
